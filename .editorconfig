# Convenções de formatação — SnakeRush
# Mantém o que o projeto já faz: recuo de 2 espaços, UTF-8, CRLF e
# linhas de no máximo 100 caracteres (achado da auditoria de 2026-10-28).
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,json,css}]
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs,css}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
